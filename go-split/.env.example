# Copy to .env.local and fill in. Never commit real values.
# Each group says which phase (GĐ, docs/tasks/00-lo-trinh.md) first needs it.

# Neon (GĐ0): pooled connection for the app, direct connection for migrations
DATABASE_URL=
DIRECT_URL=

# Better Auth (GĐ2)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (GĐ2)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend email (GĐ2)
RESEND_API_KEY=
EMAIL_FROM=

# Signs the passcode edit-session cookie (GĐ2)
EDIT_SESSION_SECRET=

# Upstash Redis rate limit (GĐ2)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Salt for hashing IPs, R53 (GĐ2)
IP_HASH_SALT=

# Cloudflare R2, private bucket for QR and cover images (GĐ3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# AES-GCM key for join-request contacts, R91 (GĐ7)
CONTACT_ENCRYPTION_KEY=

# Protects Vercel Cron routes (GĐ7)
CRON_SECRET=

# Cloudflare Turnstile (GĐ8)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
